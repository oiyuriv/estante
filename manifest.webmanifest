{
  "name": "Estante — leitor de livros",
  "short_name": "Estante",
  "description": "Sua estante de livros EPUB e MOBI no celular.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F4EEE4",
  "theme_color": "#F4EEE4",
  "lang": "pt-BR",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "livros",
          "accept": [
            "application/epub+zip", ".epub",
            "application/x-mobipocket-ebook", ".mobi",
            "application/vnd.amazon.ebook", ".azw", ".azw3",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [".epub"],
        "application/x-mobipocket-ebook": [".mobi", ".azw", ".azw3"]
      }
    }
  ]
}
